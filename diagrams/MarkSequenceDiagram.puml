@startuml
!include style.puml
skinparam ArrowFontStyle plain

title MarkCommand: add one attendance entry
participant "command:MarkCommand" as Command LOGIC_COLOR
participant "pending:ModelManager" as Model MODEL_COLOR
participant "student:Person" as Student MODEL_COLOR
[-> Command : execute(pending)
activate Command
Command -> Command : findStudent(pending)
Command -> Model : getAddressBook().getPersonList()
Model --> Command : all students
Command -> Command : findStudentGroup(student)
Command -> Student : getLabels()
Student --> Command : current labels
Command -> Student : getAttendance()
Student --> Command : attendance records
note over Command, Student
Successful path: student and group exist;
attendance for the date and group is not recorded.
Copy attendance, add the record, and create
updatedStudent with all other fields retained.
end note
Command -> Model : setPerson(student, updatedStudent)
[<-- Command : result
deactivate Command
@enduml
