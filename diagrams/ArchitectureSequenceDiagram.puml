@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Deleting a student: component responsibilities
participant "UI" as UI UI_COLOR
participant "Logic" as Logic LOGIC_COLOR
participant "Model" as Model MODEL_COLOR
participant "Storage" as Storage STORAGE_COLOR
[-> UI : request deletion by Student ID
UI -> Logic : submit deletion request
Logic -> Model : obtain current student data
Model --> Logic : current data
Logic -> Logic : prepare the proposed change
Logic -> Storage : save proposed student data
alt save succeeds
    Storage --> Logic : saved
    Logic -> Model : publish the saved change
    Logic --> UI : success and updated view
    [<-- UI : show confirmation
else save is rejected or fails
    Storage --> Logic : save failure
    Logic --> UI : failure and recovery guidance
    [<-- UI : show error; retain current view
end
@enduml
