@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Model ownership and read-only interfaces
skinparam classBackgroundColor MODEL_COLOR
interface Model <<interface>>
class ModelManager
class AddressBook
interface ReadOnlyAddressBook <<interface>>
class UserPrefs
interface ReadOnlyUserPrefs <<interface>>
class UniquePersonList
class Person
ModelManager ..|> Model
AddressBook ..|> ReadOnlyAddressBook
UserPrefs ..|> ReadOnlyUserPrefs
ModelManager *--> "1" AddressBook
ModelManager *--> "1" UserPrefs
AddressBook *--> "1" UniquePersonList
UniquePersonList --> "0..*" Person : all students
ModelManager --> "0..*" Person : filtered view
Model ..> ReadOnlyAddressBook : exposes
Model ..> ReadOnlyUserPrefs : exposes
@enduml
