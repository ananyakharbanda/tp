@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":ListCommandParser" as ListCommandParser LOGIC_COLOR
participant "l:ListCommand" as ListCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "live:ModelManager" as LiveModel MODEL_COLOR
participant "students:FilteredList<Person>" as FilteredStudents MODEL_COLOR
end box

[-> LogicManager : execute("list")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("list")
activate AddressBookParser
create ListCommandParser
AddressBookParser -> ListCommandParser : new ListCommandParser()
AddressBookParser -> ListCommandParser : parse("")
activate ListCommandParser
note right of ListCommandParser
Reject the command if any
non-blank arguments are present.
end note
create ListCommand
ListCommandParser -> ListCommand : new ListCommand()
ListCommandParser --> AddressBookParser : l
deactivate ListCommandParser
ListCommandParser -[hidden]-> AddressBookParser
destroy ListCommandParser
AddressBookParser --> LogicManager : l
deactivate AddressBookParser

note over LogicManager, LiveModel
ListCommand is read-only, so it executes on the live model
without creating a temporary model or saving student data.
end note
LogicManager -> ListCommand : execute(liveModel)
activate ListCommand
ListCommand -> LiveModel : updateFilteredPersonList(PREDICATE_SHOW_ALL_PERSONS)
activate LiveModel
LiveModel -> FilteredStudents : setPredicate(PREDICATE_SHOW_ALL_PERSONS)
activate FilteredStudents
FilteredStudents --> LiveModel : complete student view restored
deactivate FilteredStudents
LiveModel --> ListCommand
deactivate LiveModel
ListCommand -> LiveModel : getFilteredPersonList()
LiveModel --> ListCommand : students
ListCommand -> FilteredStudents : isEmpty()
activate FilteredStudents
FilteredStudents --> ListCommand : isEmpty
deactivate FilteredStudents
alt student list is empty
    ListCommand --> LogicManager : CommandResult("No students found.")
else student list is not empty
    ListCommand --> LogicManager : CommandResult("Listed all students.")
end
deactivate ListCommand

[<-- LogicManager : result
deactivate LogicManager
@enduml
