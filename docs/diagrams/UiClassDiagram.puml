@startuml
!include style.puml
skinparam ArrowFontStyle plain

title UI classes: selected ownership and creation relationships
skinparam classBackgroundColor UI_COLOR
interface Ui <<interface>>
class UiManager
class MainWindow
class HelpWindow
class CommandBox
class ResultDisplay
class PersonListPanel
class PersonCard
class AttendanceListPanel
class AttendanceCard
class StatusBarFooter
UiManager ..|> Ui
UiManager --> "1" MainWindow
MainWindow *--> "1" HelpWindow
MainWindow *--> "1" CommandBox
MainWindow *--> "1" ResultDisplay
MainWindow *--> "1" PersonListPanel
MainWindow *--> "1" StatusBarFooter
MainWindow ..> AttendanceListPanel : <<create>>
PersonListPanel ..> PersonCard : <<create>>
AttendanceListPanel ..> AttendanceCard : <<create>>
@enduml
