@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Parsing classes: AddCommandParser as a representative
skinparam classBackgroundColor LOGIC_COLOR
interface "Parser<AddCommand>" as Parser <<interface>>
class AddressBookParser
class AddCommandParser
class AddCommand
class ArgumentTokenizer
class ArgumentMultimap
class ParserUtil
class CliSyntax
class Prefix
AddressBookParser ..> AddCommandParser : <<create>>
AddCommandParser ..|> Parser
AddCommandParser ..> AddCommand : <<create>>
AddCommandParser ..> ArgumentTokenizer : tokenizes
ArgumentTokenizer ..> ArgumentMultimap : <<create>>
ArgumentTokenizer ..> Prefix
ArgumentMultimap ..> Prefix
AddCommandParser ..> ArgumentMultimap : reads values
AddCommandParser ..> ParserUtil : validates fields
AddCommandParser ..> CliSyntax : uses prefix constants
CliSyntax --> Prefix
@enduml
