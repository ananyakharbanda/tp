<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox styleClass="attendance_header">
    <minHeight>
      <!-- Preserve the full wrapped heading before allocating the remaining height to the list. -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minHeight>
    <padding>
      <Insets top="5" right="5" bottom="5" left="15" />
    </padding>
    <Label fx:id="title" styleClass="cell_big_label" wrapText="true" maxWidth="Infinity" />
    <Label fx:id="totals" styleClass="cell_small_label" />
  </VBox>
  <!-- Allow the list to fit the space left by the heading, including when its placeholder is shown. -->
  <ListView fx:id="attendanceListView" minHeight="0" VBox.vgrow="ALWAYS" />
</VBox>
